    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug UWB-Anchor",
            "request": "launch",
            "type": "cortex-debug",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/target/thumbv7em-none-eabihf/release/uwb-anchor",
            "svdFile": "${workspaceFolder}/stm32l4x2.svd",
            "servertype": "openocd",
            "configFiles": ["stm32l432.cfg"],
            "preLaunchTask": "Build binary",
            "preLaunchCommands": [
                "monitor init",
                "monitor reset init",
                "monitor halt",
                "monitor flash write_image erase ./target/thumbv7em-none-eabihf/release/uwb-anchor 0x08000000"
            ],
            "postLaunchCommands": ["continue"] // Don't stop before at the first line
        }
    ]
}